# Production template — copy to .env ON THE SERVER ONLY. Never commit a filled-in .env.
APP_NAME="Property Connect BD"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show (store a copy in your password manager)
APP_DEBUG=false
APP_URL=https://www.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db                     # docker compose service name (docker-compose.prod.yml)
DB_PORT=5432
DB_DATABASE=pcbd
DB_USERNAME=pcbd
DB_PASSWORD=                   # strong, unique

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_URL=/storage # or https://cdn.example.com/storage when a CDN/object store is used

# Admin 2FA must stay enabled in production.
PCBD_ADMIN_MFA_REQUIRED=true

# Behind Cloudflare/nginx reverse proxy: comma-separated proxy IPs, or * only if the app is not directly reachable.
TRUSTED_PROXIES=*              # docker deployment: app is reachable only via the Cloudflare Tunnel

# Docker deployment (ADR-0018): token from Cloudflare Zero Trust > Networks > Tunnels. Server .env only.
CLOUDFLARE_TUNNEL_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
